# Copy this file to .env and fill in your values.
# Only needed for `npm run generate-audio` — the app itself doesn't use it.

# Get a key from https://elevenlabs.io (Profile → API keys)
ELEVENLABS_API_KEY=

# Optional: voice to use. Defaults to "Rachel" (21m00Tcm4TlvDq8ikWAM).
ELEVENLABS_VOICE_ID=
